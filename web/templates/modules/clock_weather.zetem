<header class="top" data-clock data-tz="{{{ $tz }}}">
    <div class="top-main">
        <div class="brand">Dashboard <span>{{{ $home_label }}}</span></div>
        <div class="clock" aria-live="off"><span data-clock-hm>{{{ $now_hm }}}</span><small data-clock-s>{{{ $now_s }}}</small></div>
        <div class="date" data-clock-date>{{{ $now_date }}}</div>
    </div>

    <div class="wx" data-weather data-weather-url="{{{ $weather_url }}}">
        <div class="wx-temp" data-wx-temp>{{{ $temp_text }}}</div>
        <div class="wx-label" data-wx-label>{{{ $weather_label }}}</div>
    </div>

    <div class="userbar">
        <span class="who">{{{ $display_name }}}</span>
        <span class="actions">
            {% if($can_update): %}<button type="button" class="linklike" data-git-pull aria-label="Update the dashboard from git">Update</button>{% endif %}
            <button type="button" class="linklike" data-theme-toggle aria-label="Change colour theme">Theme</button>
            <a href="{{{ $logout_url }}}">Sign out</a>
        </span>
    </div>
</header>

{% if($can_update): %}
<dialog id="update-dialog" class="dlg" data-update-url="{{{ $update_url }}}">
    <div class="update-box">
        <h3 data-update-title>Update</h3>
        <p data-update-message role="status"></p>
        <pre class="update-output" data-update-output hidden></pre>
        <ul class="update-hints" data-update-hints hidden></ul>
        <div class="dlg-actions">
            <button type="button" class="btn" data-close-dialog>Close</button>
            <button type="button" class="btn btn-solid" data-update-reload hidden>Reload page</button>
        </div>
    </div>
</dialog>
{% endif %}
