# Reference cron.d entry for ZPrime's nightly backup + periodic health
# check, via the shared zops engine (lib/zops -- see
# lib/zops/docs/INSTALL.md).
#
# Install:
#   sudo cp deploy/zprime-backup.cron /etc/cron.d/zprime-backup
#   sudo chmod 644 /etc/cron.d/zprime-backup
#
# See deploy/backup.conf.example's own comment for the recommended
# dedicated "zops" system user and why.

# Nightly backup.
0 2 * * *  zops  flock -n /run/lock/zops-zprime-backup.lock /var/www/zprime/lib/zops/bin/zops-backup --site=zprime >> /var/log/zops/zprime-backup-cron.log 2>&1

# Health check every 15 minutes -- --email-on-change means this only
# actually emails the administrator (ADMIN_EMAIL in /etc/zops/defaults.conf)
# when something changes, or a failure has persisted long enough to
# warrant a reminder, not on every single run.
*/15 * * * *  zops  /var/www/zprime/lib/zops/bin/zops-monitor --site=zprime --email-on-change >> /var/log/zops/zprime-monitor-cron.log 2>&1
